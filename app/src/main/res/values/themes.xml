      el fondo y las barras del sistema a juego para que el arranque no parpadee en blanco.
    -->
    <style name="Theme.ServidorMC" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FF0A0E17</item>
        <item name="android:windowBackground">#FF0A0E17</item>
        <item name="android:statusBarColor">#FF0A0E17</item>
        <item name="android:navigationBarColor">#FF0A0E17</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
